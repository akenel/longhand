# Longhand — copy to .env and edit. .env is gitignored.

# ---------------------------------------------------------------
# LOCAL (all you need to start writing)
# ---------------------------------------------------------------

# What you're writing. Mount ONLY this — not the repo root, not $HOME.
WRITING_DIR=./workspace

# Loopback port. http://127.0.0.1:8443
LONGHAND_PORT=8443

# So files you create belong to you, not root. Check with: id -u; id -g
LONGHAND_UID=1000
LONGHAND_GID=1000

LONGHAND_MEM=1024m

# ---------------------------------------------------------------
# PROD (only needed with docker-compose.prod.yml — read its header first)
# ---------------------------------------------------------------

# LONGHAND_DOMAIN=write.wolfhold.app
# AUTH_DOMAIN=auth.wolfhold.app

# Dedicated Keycloak client. Not a shared one.
# LONGHAND_CLIENT_SECRET=

# openssl rand -base64 32
# OAUTH2_PROXY_COOKIE_SECRET=

# The line that decides who gets a shell on your box. Fails closed.
# LONGHAND_ALLOWED_GROUPS=/writers

# docker network ls | grep freehold
# FREEHOLD_NETWORK=freehold_freehold
